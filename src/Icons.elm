module Icons exposing (Icons(..), render)

import Colors exposing (RGBColor)
import Svg exposing (..)
import Svg.Attributes as Attr


type Icons
    = Settings
    | Go
    | EnterFullscreen
    | ExitFullscreen


render : Icons -> RGBColor -> RGBColor -> Float -> Svg msg
render icon color borderColor width =
    case icon of
        Settings ->
            renderSettings
                (Colors.toHtmlString color)
                (Colors.toHtmlString borderColor)
                width

        Go ->
            renderGo
                (Colors.toHtmlString color)
                (Colors.toHtmlString borderColor)
                width

        EnterFullscreen ->
            renderEnterFullscreen
                (Colors.toHtmlString color)
                (Colors.toHtmlString borderColor)
                width

        ExitFullscreen ->
            renderExitFullscreen
                (Colors.toHtmlString color)
                (Colors.toHtmlString borderColor)
                width


scaleString : Float -> Float -> Float -> Float -> String
scaleString orgW orgH w h =
    "scale("
        ++ String.fromFloat (w / orgW)
        ++ ", "
        ++ String.fromFloat (h / orgH)
        ++ ")"



